{
  "name": "sqlite-learning-todo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "db:import": "node scripts/import.js",
    "demo": "node scripts/demo.js",
    "test": "node --test",
    "format": "prettier --write package.json src scripts test frontend public/index.html public/style.css README.md SQLite.md Presentation.md",
    "format:check": "prettier --check package.json src scripts test frontend public/index.html public/style.css README.md SQLite.md Presentation.md",
    "demo:relations": "node scripts/relations.js",
    "build": "node scripts/build.js",
    "prestart": "npm run build",
    "test:ui": "npm run build && node scripts/ui-check.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "esbuild": "^0.28.2",
    "prettier": "3.9.9"
  },
  "dependencies": {
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
